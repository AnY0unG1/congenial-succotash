{
	"schemaVersion": 1,
	"id": "server-core",
	"version": "${version}",
	"name": "Server Core",
	"description": "服务器登录保护与网易云共享唱片机。支持全服共享账号、扫码登录、歌单、同步播放控制及自定义背景。更新日志见模组内 CHANGELOG.md。",
	"authors": [
		"AnY0unG1"
	],
	"license": "CC0-1.0",
	"environment": "*",
	"entrypoints": {
		"main": ["io.github.anyoung1.servercore.music.MusicMod"],
		"server": ["io.github.anyoung1.servercore.ServerCore"],
		"client": ["io.github.anyoung1.servercore.music.client.MusicClient"]
	},
	"mixins": [
		{"config": "server-core.mixins.json", "environment": "server"}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
